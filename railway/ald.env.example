# ALD Railway Service Environment Variables
# Set these in Railway dashboard → ald service → Variables

TENANT_SLUG=ald
NODE_ENV=production
PORT=3000

# Supabase — use service role key for server-side, anon for client
NEXT_PUBLIC_SUPABASE_URL=https://vpumgmasnggconvgujho.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from Supabase dashboard>
SUPABASE_SERVICE_ROLE_KEY=<from Supabase dashboard>

# Stripe
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend
RESEND_API_KEY=re_...

# Anthropic (for Lexie)
ANTHROPIC_API_KEY=sk-ant-...

# Google
GOOGLE_PLACES_API_KEY=...

# Cloudflare (set in CF dashboard, not Railway)
# CLOUDFLARE_ZONE_ID=...
